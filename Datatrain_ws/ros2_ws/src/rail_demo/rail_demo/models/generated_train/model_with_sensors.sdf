    <link name="camera_1_top_aoi_plane_r1_c2_link">
  <pose>0.017925 -0.366671 1.14 0.0 0.0 -1.571</pose>
  <gravity>false</gravity>
  <mass>0.01</mass>
  <inertia>
    <ixx>1e-4</ixx>
    <iyy>1e-4</iyy>
    <izz>1e-4</izz>
    <ixy>0</ixy>
    <ixz>0</ixz>
