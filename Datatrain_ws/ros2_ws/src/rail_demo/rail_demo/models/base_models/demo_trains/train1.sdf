    <link name="lidar_simple_top_aoi_plane_r0_c0_link">
  <pose>0.018 -4e-06 0.8 0.0 0.0 0.0</pose>
  <gravity>false</gravity>
  <mass>0.01</mass>
  <inertia>
  <ixx>1e-4</ixx>
  <iyy>1e-4</iyy>
  <izz>1e-4</izz>
  <ixy>0</ixy>
  <ixz>0</ixz>
  <iyz>0</iyz>
</inertia>
<visual name="lidar_body_visual">
            <geometry>
                <cylinder>
                <radius>0.03</radius>
                <length>0.05</length>
                </cylinder>
            </geometry>
            <material>
                <ambient>0.0 0.0 0.0 1</ambient>
                <diffuse>0.0 0.0 0.0 1</diffuse>
            </material>
            </visual>

  <sensor name="lidar_simple" type="gpu_lidar">
    <pose>0 0 0 0 0 0</pose>
    <topic>lidar</topic>
    <update_rate>10.0</update_rate>
    <always_on>true</always_on>
    <visualize>true</visualize>

    <ray>
      <scan>
        <horizontal>
          <samples>1024</samples>
          <resolution>1.0</resolution>
          <min_angle>-3.1415925</min_angle>
          <max_angle>3.1415925</max_angle>
        </horizontal>
        <vertical>
          <samples>1</samples>
          <resolution>1.0</resolution>
          <min_angle>-0.0</min_angle>
          <max_angle>0.0</max_angle>
        </vertical>
      </scan>

      <range>
        <min>0.8</min>
        <max>120.0</max>
        <resolution>0.01</resolution>
      </range>
    </ray>
  </sensor>
</link>

<joint name="lidar_simple_top_aoi_plane_r0_c0_joint" type="fixed">
  <parent>base_link</parent>
  <child>lidar_simple_top_aoi_plane_r0_c0_link</child>
</joint>


<link name="camera_front_front_aoi_plane_r1_c0_link">
  <pose>0.117796 -1.000024 0.6 0.0 0.0 -1.57</pose>
  <gravity>false</gravity>
  <mass>0.01</mass>
  <inertia>
  <ixx>1e-4</ixx>
  <iyy>1e-4</iyy>
  <izz>1e-4</izz>
  <ixy>0</ixy>
  <ixz>0</ixz>
  <iyz>0</iyz>
</inertia>
<visual name="camera_body_visual">
            <geometry>
                <cylinder>
                <radius>0.03</radius>
                <length>0.05</length>
                </cylinder>
            </geometry>
            <material>
                <ambient>0.0 0.0 0.0 1</ambient>
                <diffuse>0.0 0.0 0.0 1</diffuse>            
            </material>
            </visual>

  <sensor name="camera_front" type="camera">
    <pose>0 0 0 0 0 0</pose>
    <topic>camera/image</topic>
    <update_rate>30.0</update_rate>
    <always_on>true</always_on>
    <visualize>true</visualize>

    <camera>
      <horizontal_fov>1.396263</horizontal_fov>

      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>

      <clip>
        <near>0.1</near>
        <far>100.0</far>
      </clip>
    </camera>
  </sensor>
</link>

<joint name="camera_front_front_aoi_plane_r1_c0_joint" type="fixed">
  <parent>base_link</parent>
  <child>camera_front_front_aoi_plane_r1_c0_link</child>
</joint>
<plugin name="gz::sim::systems::DiffDrive" filename="gz-sim-diff-drive-system">

      <ros>

      </ros>

      <update_rate>12</update_rate>

      <!-- wheels -->
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>


      <!-- kinematics -->
      <wheel_separation>0.44</wheel_separation>
      <wheel_diameter>0.21</wheel_diameter>

      <!-- limits -->
      <max_wheel_torque>50</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>

      <!-- output -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

    </plugin>
    
         	     
  </model>
</sdf>
